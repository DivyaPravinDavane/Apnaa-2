# =============================================================================
#  Apnaa Smart Society - environment variables
#  Copy this file to .env.local and fill in real values. Never commit secrets.
# =============================================================================

# --- MySQL -------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=apnaa_app
DB_PASSWORD=replace-with-a-long-random-password
DB_NAME=apnaa_society

# --- Sessions ----------------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_MINUTES=480

# --- Application -------------------------------------------------------------
APP_URL=http://localhost:3000
# Comma-separated list, only needed when the API is served from another origin.
ALLOWED_ORIGINS=http://localhost:3000
DEFAULT_SOCIETY_ID=soc_green_valley_01

# Demo role switcher. Keep false in production; real users should sign in with
# the OTP or password endpoints.
ALLOW_DEMO_LOGIN=true

# --- Frontend data source & API Key ------------------------------------------
# 'api' uses the secured MySQL backend in src/app/api/v1.
# 'mock' keeps the original in-memory demo data (no database required).
API_KEY=replace-with-your-apnaa-api-key
NEXT_PUBLIC_API_KEY=replace-with-your-apnaa-api-key
NEXT_PUBLIC_DATA_SOURCE=api
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_DEFAULT_SOCIETY_ID=soc_green_valley_01
