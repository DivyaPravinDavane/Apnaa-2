# Smart Society Platform Environment Variables
# API base URL for PHP REST API (e.g., http://localhost:8000/api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Data mode: 'mock' uses the in-memory typed client; 'api' points to the PHP backend
NEXT_PUBLIC_DATA_SOURCE=mock

# Demonstration Society ID
NEXT_PUBLIC_DEFAULT_SOCIETY_ID=soc_green_valley_01
